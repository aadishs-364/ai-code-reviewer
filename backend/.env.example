# Copy to .env and fill in. All values are optional — the app runs without them
# (falling back to the local heuristic reviewer and disabling GitHub features).

# --- Database -------------------------------------------------------------
# SQLite for local dev. For production, point at Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/codereview
DATABASE_URL=sqlite:///./codereview.db

# --- Claude / Anthropic ---------------------------------------------------
# Without a key, reviews use the built-in static-analysis engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_MAX_TOKENS=16000

# --- Gemini fallback (tried in order if Claude fails) ----------------------
GEMINI_API_KEY=
GEMINI_MODELS=["gemini-3.1-pro-preview","gemini-3.8-flash","gemini-3.5-flash"]
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- GitHub integration ---------------------------------------------------
# Token needs pull_requests: read/write (PAT or GitHub App installation token).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Shared secret configured on the webhook; enables signature verification.
GITHUB_WEBHOOK_SECRET=
